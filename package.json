{
  "name": "treefs",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "start:dev": "pnpm --filter backend start:dev",
    "start:debug": "pnpm --filter backend start:debug",
    "dev:web": "pnpm --filter web dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm test:e2e"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
